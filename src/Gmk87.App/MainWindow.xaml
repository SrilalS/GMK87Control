<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Gmk87.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GMK87 Control">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="TitleBarArea" Orientation="Horizontal" Spacing="10" Padding="16,0" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE765;" FontSize="14" />
            <TextBlock Text="GMK87 Control" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="200"
            SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Device" Tag="Device">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Lighting" Tag="Lighting">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE706;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Keymap" Tag="Keymap">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE92E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Screen" Tag="Display">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB9F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Padding="0" />
        </NavigationView>

        <InfoBar x:Name="ToastBar" Grid.Row="1" IsOpen="False" IsClosable="True" MaxWidth="480" MinWidth="280"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                 Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                 BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
    </Grid>
</Window>
