<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Gmk87.App.Pages.KeymapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="16">
            <Grid>
                <TextBlock Text="Keymap" Style="{StaticResource TitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
                    <Button Content="Read from keyboard" Click="OnReadClick" />
                    <Button x:Name="SaveBackupButton" Content="Save backup..." Click="OnSaveBackupClick" IsEnabled="False" />
                    <Button x:Name="RestoreButton" Content="Restore backup..." Click="OnRestoreClick" IsEnabled="False" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="Layer" VerticalAlignment="Center" />
                <RadioButtons x:Name="LayerPicker" MaxColumns="4" SelectedIndex="0" SelectionChanged="OnLayerChanged">
                    <x:String>0 (base)</x:String>
                    <x:String>1 (Fn)</x:String>
                    <x:String>2</x:String>
                    <x:String>3</x:String>
                </RadioButtons>
                <TextBlock x:Name="SchemeInfo" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="24,0,0,0" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                    <Canvas x:Name="KeyCanvas" />
                </Viewbox>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Edit key" Style="{StaticResource SectionHeader}" />
                        <TextBlock x:Name="SelectedInfo" Text="Read the keymap, then click a key." TextWrapping="Wrap" />
                        <TextBlock x:Name="PendingInfo" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="10">
                        <AutoSuggestBox x:Name="KeySearch" Header="New keycode" PlaceholderText="Search: A, Esc, Volume, MO(1)..."
                                        TextChanged="OnSearchTextChanged" SuggestionChosen="OnSuggestionChosen" IsEnabled="False" />
                        <Button x:Name="WriteKeyButton" Content="Write key to keyboard" Style="{StaticResource AccentButtonStyle}"
                                Click="OnWriteKeyClick" IsEnabled="False" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <TextBox x:Name="HexBox" Grid.Column="2" Header="or raw hex" PlaceholderText="0x0004" TextChanged="OnHexChanged"
                             IsEnabled="False" VerticalAlignment="Top" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
