<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Gmk87.App.Pages.DisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="16" MaxWidth="1100" HorizontalAlignment="Left">
            <Grid>
                <TextBlock Text="Screen" Style="{StaticResource TitleTextBlockStyle}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" HorizontalAlignment="Right" />
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.Slot1.Title}" Style="{StaticResource SectionHeader}" />
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Width="362" Height="204" Background="Black">
                            <Image Source="{x:Bind ViewModel.Slot1.Preview}" Width="360" Height="202.5" Stretch="Fill" />
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.Slot1.Summary, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Choose image or GIF..." Command="{x:Bind ViewModel.PickSlot1Command}" />
                            <Button Content="Clear" Command="{x:Bind ViewModel.ClearSlot1Command}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.Slot2.Title}" Style="{StaticResource SectionHeader}" />
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Width="362" Height="204" Background="Black">
                            <Image Source="{x:Bind ViewModel.Slot2.Preview}" Width="360" Height="202.5" Stretch="Fill" />
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.Slot2.Summary, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Choose image or GIF..." Command="{x:Bind ViewModel.PickSlot2Command}" />
                            <Button Content="Clear" Command="{x:Bind ViewModel.ClearSlot2Command}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Settings" Style="{StaticResource SectionHeader}" />
                    <NumberBox Header="Frame delay (ms)" Minimum="60" Maximum="65535" SmallChange="10" LargeChange="100"
                               SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.FrameDelayMs, Mode=TwoWay}" Width="220" HorizontalAlignment="Left" />
                    <ComboBox Header="Screen shows" ItemsSource="{x:Bind ViewModel.ScreenModes}"
                              SelectedIndex="{x:Bind ViewModel.ShowAfter, Mode=TwoWay}" Width="220" />
                    <ProgressBar Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Maximum="100" Width="460" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Upload both slots" Style="{StaticResource AccentButtonStyle}" Click="OnUploadClick" />
                        <Button Content="Only switch screen + sync clock" Click="OnSwitchClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
